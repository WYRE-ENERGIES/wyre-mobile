{
  "expo": {
    "name": "Wyre",
    "slug": "wyre-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wyre-app-icon.png",
    "scheme": "wyreapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/wyre-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wyreng.ems",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.wyreng.ems",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#5C12A7",
        "foregroundImage": "./assets/images/wyre-adaptive-foreground.png",
        "backgroundImage": "./assets/images/wyre-adaptive-background.png",
        "monochromeImage": "./assets/images/wyre-adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/wyre-logo.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "backgroundColor": "#F4F2F8",
          "dark": {
            "image": "./assets/branding/wyre-logo-white.png",
            "backgroundColor": "#05010A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5C12A7",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": ["RNFBApp", "RNFBMessaging"]
          }
        }
      ],
      "./plugins/with-fmt-consteval-fix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
